{
  "name": "dsh-glass-skin",
  "version": "0.3.26",
  "description": "Liquid Glass skin for DeepSeek Harness (DSH): frosted app bar, glass sidebar, translucent surfaces, flat colors with no gradients. Web + mobile WebView.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "skin",
    "liquid-glass",
    "ui"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "LICENSE-Inter.txt",
    "LICENSE-BeVietnamPro.txt"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": ">=0.1.7-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "author": "24mlight",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/24mlight/dsh-liquid-glass.git"
  },
  "homepage": "https://github.com/24mlight/dsh-liquid-glass#readme",
  "bugs": {
    "url": "https://github.com/24mlight/dsh-liquid-glass/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
